# Copy this file to .env and paste your real key in.
# .env is gitignored. Never commit the real one.

GEMINI_API_KEY=paste_your_key_here

# gemini-2.5-flash-lite has the most generous free limits (~1000 req/day).
# gemini-2.5-flash is smarter but capped lower (~250/day).
MODEL=gemini-2.5-flash

# Optional. Uncomment to disable the model's internal reasoning.
# Faster and cheaper, but noticeably worse at multi-step planning.
# Only useful as a fallback if thought-signature errors reappear.
# THINKING_BUDGET=0
