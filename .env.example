# Copy this file to .env and paste your real key in.
# .env is gitignored. Never commit the real one.

GEMINI_API_KEY=paste_your_key_here

# Run `python list_models.py` to see what YOUR key can use — availability
# differs by account and models get retired for new users without notice.
#
# Two rules learned the hard way:
#   1. Never use a *-latest alias. It resolves to the newest model, which is
#      the one with the SMALLEST free quota (gemini-3.7-flash: 20/day).
#   2. Prefer flash-lite variants while iterating — biggest daily allowance.
#
# One agent run costs 4-6 requests. Budget accordingly.
MODEL=gemini-3.6-flash

# Optional. Uncomment to disable the model's internal reasoning.
# Faster and cheaper, but noticeably worse at multi-step planning.
# Only useful as a fallback if thought-signature errors reappear.
# THINKING_BUDGET=0
