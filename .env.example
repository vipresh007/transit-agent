# Copy to .env and fill in. .env is gitignored — never commit the real one.
#
# Every provider below speaks the OpenAI chat-completions format, so switching
# is three lines of config and zero lines of code. Keep two configured: free
# tiers run dry, and having a spare turns a dead afternoon into a 10-second fix.

# ---------------------------------------------------------------------------
# Google Gemini  —  https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=paste_your_key_here
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL=gemini-3.6-flash

# Run `python list_models.py` to see what YOUR key can actually use.
# Availability differs by account and models retire without notice.
#
# Two rules learned the hard way:
#   1. Never use a *-latest alias — it resolves to the newest model, which is
#      the one with the SMALLEST free quota (gemini-3.7-flash: 20/day).
#   2. Prefer flash-lite variants while iterating: biggest daily allowance.

# ---------------------------------------------------------------------------
# Groq  —  https://console.groq.com/keys
# Very fast, generous free tier, good tool-calling support.
# ---------------------------------------------------------------------------
# API_KEY=gsk_your_groq_key
# BASE_URL=https://api.groq.com/openai/v1
# MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# OpenRouter  —  https://openrouter.ai/keys
# One key, many models. Append :free to get the free-tier variants.
# ---------------------------------------------------------------------------
# API_KEY=sk-or-your_openrouter_key
# BASE_URL=https://openrouter.ai/api/v1
# MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---------------------------------------------------------------------------
# Ollama (local)  —  https://ollama.com
# No quota, no key, works offline. Needs ~8GB RAM. Slower, and smaller models
# are noticeably worse at multi-step tool use — but unlimited iteration.
#   ollama pull qwen2.5:7b
# ---------------------------------------------------------------------------
# API_KEY=ollama
# BASE_URL=http://localhost:11434/v1
# MODEL=qwen2.5:7b

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# Max tool-calling steps before the agent is forced to answer.
# MAX_STEPS=12

# Disable model reasoning. Cheaper and faster, worse at planning.
# Only needed as a fallback for thought-signature errors.
# THINKING_BUDGET=0
